generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  creature
  post
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubId     String   @unique
  username     String   @unique
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Creature {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String          @unique
  nameJa       String
  description  String
  scientific   String?
  foundAt      DateTime?
  locationText String?
  tags         String[]        @default([])
  photos       CreaturePhoto[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model CreaturePhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatureId String   @db.Uuid
  url        String
  alt        String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  creature   Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  title       String
  body        String
  publishedAt DateTime
  coverUrl    String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchChunk {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentType ContentType
  contentId   String                 @db.Uuid
  url         String
  title       String
  chunkText   String
  embedding   Unsupported("vector")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([contentType, contentId])
}

